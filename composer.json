{
    "name": "we-go/wp-go-blocks",
    "description": "ACF block.json blocks: one folder per block, per-post-type variants, per-block assets, blocks drawn from templates. Rendered with the engine the theme names: Twig through Timber (TimberRenderer), or any other.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "timber/timber": "^2.2: for TimberRenderer (Twig) and TimberEntities"
    },
    "autoload": {
        "psr-4": {
            "WpGo\\Blocks\\": "src/"
        },
        "files": [
            "src/boot.php",
            "src/Core/register.php",
            "src/Core/block-settings.php",
            "src/Core/block-settings-screen.php",
            "src/Core/preview-uploads.php",
            "src/Core/render.php",
            "src/Core/fields-read.php",
            "src/Core/fields-write.php",
            "src/Core/template.php",
            "src/Core/assets.php"
        ]
    }
}
